{
  "name": "grok-bot-mcp-agent",
  "version": "0.1.0",
  "description": "Universal AI-in-the-Loop Grok Supervisor and Agentic Human Proxy for T3 Code, ACP, Codex, and Claude Code",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "grok-supervisor": "dist/index.js",
    "grok-agent-bridge": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "examples",
    "LICENSE",
    "runtime-lock.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && tsc -p tsconfig.test.json",
    "check": "npm run lint && npm test && npm run build",
    "start": "node dist/index.js",
    "prepack": "npm run build && node scripts/prepare-package.mjs",
    "pack:onboarding": "node scripts/package-onboarding.mjs"
  },
  "keywords": [
    "grok",
    "mcp",
    "acp",
    "agentic",
    "supervisor",
    "human-in-the-loop",
    "t3-code",
    "codex",
    "claude-code"
  ],
  "author": "Vedant",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "jsonc-parser": "^3.3.1",
    "typescript": "5.9.3",
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
